---
import "../styles/global.css";
import "../styles/tutorial.css";
import Sidebar from "../components/Sidebar.astro";
import TOC from "../components/TOC.astro";
import { ClientRouter } from "astro:transitions";
const { frontmatter, headings } = Astro.props;
const majorHeadings = headings.filter((header) => header.depth < 4);
---

<html lang="en">
    <head>
        <ClientRouter />
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/v1/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{frontmatter.title}</title>
    </head>
    <body class="min-h-screen">
        <Sidebar class="h-dvh" style="z-index: 5;" />

        <div
            class="ml-80 xl:mr-64 mb-4 relative"
            style="z-index: 0;"
            transition:animate="none"
        >
            <h1 class="">{frontmatter.title}</h1>
            <hr class="h-0.5 bg-black opacity-30" />
            <div class="markdown">
                <slot style={markdownStyle} class={markdownClass} />
            </div>
        </div>

        <aside class="toc-aside hidden xl:block w-48 fixed top-0 right-0 bottom-0 overflow-y-auto p-6 pt-16 border-l border-[#DCF3FA]">
            <TOC sections={majorHeadings} />
        </aside>
    </body>
</html>

<style>
    .toc-aside {
        background-color: #F9FAFC;
    }

    html.dark .toc-aside {
        background-color: #1e2938;
    }
</style>
