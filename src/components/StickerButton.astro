---
export interface Props {
	text: string;
	href: string;
	color?: string;
	target?: string;
}

const { text, href, color = "#FDAD0E", target } = Astro.props;
---

<a
	href={href}
	target={target}
	rel={target === "_blank" ? "noopenner noreferrer" : undefined}
	class="inline-block"
>
	<div
		class="bg-white rounded-full p-1 shadow-[2px_2px_2px_rgba(0,0,0,0.2)] hover:scale-103 transition-transform duration-100"
	>
		<div
			class="rounded-full px-8 py-2 text-white text-lg text-center whitespace-nowrap"
			style={`background-color: ${color};`}
		>
			{text}
		</div>
	</div>
</a>
