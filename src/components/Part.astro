---
export interface Props {
	quantity: string;
	title: string;
	content: string;
	image: string;
}

const { quantity, title, content, image } = Astro.props;
---

<div
    class="h-full flex flex-col items-center border-dashed border-4 rounded-md border-[#FF477B] bg-white p-8 pb-4 pt-6 text-[#FF477B] hover:text-[#FF7A60] hover:border-[#FF7A60] relative hover:scale-102 transition"
>
    <div class="absolute top-0 -right-4 rotate-12">
        <img src="/v1/cardnum.svg" class="relative" />
        <p
            class="absolute top-0 right-0 text-white text-2xl flex items-center justify-center w-full h-full"
        >
            x{quantity}
        </p>
    </div>
    <img src={image} class="w-24 sm:w-32 md:w-44 h-24 sm:h-32 md:h-44 object-contain" />
    <p class="text-xl mt-2">{title}</p>
    <p class="font-['Archivo']">{content}</p>
</div>
