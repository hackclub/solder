---
export interface Props {
	quantity: string;
	title: string;
	content: string;
	image: string;
}

const { quantity, title, content, image } = Astro.props;
---

<div
    class="border-dashed border-4 rounded-md border-[#FF60A8] bg-white p-8 pb-4 pt-6 text-[#FF60A8] hover:text-[#FF7A60] hover:border-[#FF7A60] relative hover:scale-102 transition"
>
    <div class="absolute top-0 -right-4 rotate-12">
        <img src="/v1/cardnum.svg" class="relative" />
        <p
            class="absolute top-0 right-0 text-white text-2xl flex items-center justify-center w-full h-full"
        >
            x{quantity}
        </p>
    </div>
    <img src={image} class="w-44" />
    <p class="text-xl mt-2">{title}</p>
    <p class="font-['Archivo']">{content}</p>
</div>
