---
import "../styles/global.css";
import ThemeToggle from "./ThemeToggle.astro";
const posts = import.meta.glob("../pages/*.md", { eager: true });

// To array
const postList = Object.entries(posts)
	.map(([path, post]: [string, any]) => {
		const slug = path.replace("../pages/", "").replace(/\.md$/, "");

		return {
			slug,
			...post.frontmatter,
		};
	})
	.filter((post) => post.show);

postList.sort((a, b) => a.order - b.order);

const currentPath = Astro.url.pathname.replaceAll("/", "");

const sectionBySlug: Record<string, string> = {
	start: "Start Here",
	resources: "Start Here",
	parts: "Guide",
	tutorial: "Guide",
	"easyeda-tutorial": "Guide",
	"advanced-tutorial": "Guide",
	art: "Guide",
	submit: "Submit",
	leaders: "Submit",
	"next-steps": "Submit",
};

const sectionOrder = ["Start Here", "Guide", "Submit"];

const sections = sectionOrder.map((title) => ({
	title,
	posts: postList.filter((post) => sectionBySlug[post.slug] === title),
}));
---

<div
    class="w-64 bg-gray-800 text-white fixed top-0 left-0 flex flex-col bottom-0"
>
    <nav class="flex-1 overflow-y-auto">
        <a href="/">
            <img src="/v1/animelogo.png" class="w-full p-5" />
        </a>
        <ul class="px-4 space-y-6">
            {
                sections.map((section) => (
                    <li>
                        <div class="flex items-center justify-between px-2 py-1 text-white font-bold text-sm">
                            {section.title}
                        </div>
                        <ul class="mt-1 ml-2 pl-3 border-l border-gray-600 space-y-0.5">
                            {section.posts.map((post) => {
                                const isActive = `${post.slug}` === currentPath;
                                return (
                                    <li>
                                        <a
                                            href={`/${post.slug}`}
                                            class={
                                                "block py-1 px-3 rounded-md text-gray-300 hover:bg-gray-700 hover:text-white text-base " +
                                                (isActive ? "active" : "")
                                            }
                                        >
                                            {post.title}
                                        </a>
                                    </li>
                                );
                            })}
                        </ul>
                    </li>
                ))
            }
        </ul>
    </nav>
    <div class="p-4 border-t border-gray-700 flex items-center justify-between">
        <a href="/" class="text-sm text-gray-400 hover:text-white">
            ← back to home
        </a>
        <ThemeToggle />
    </div>
</div>

<style>
    .active {
        font-weight: bold;
        background-color: var(--color-gray-700);
    }
</style>
